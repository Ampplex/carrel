# Copy to backend/.env and fill in. Never commit the real file.

# Your Reeve API key from https://reeve.co.in — this stays server-side and is
# never sent to the browser.
REEVE_API_KEY=sk-...

# Which namespace inside your Reeve account this app writes to. The server
# composes "uid:namespace", so this partitions within your account. It is NOT a
# security boundary — the app owns it, clients never supply it.
CARREL_NAMESPACE=Carrel-demo

# Dev frontend origin for CORS.
ALLOWED_ORIGINS=http://localhost:5173

# Guards the destructive namespace wipe. Leave false unless you mean it.
CARREL_ALLOW_RESET=false

# Serves recorded answers behind a visible REPLAY badge, for demoing without
# a network. Never enable this silently.
CARREL_DEMO_REPLAY=false

# Every Google OAuth client allowed to sign somebody in, comma separated.
# Google issues one per platform and the ID token names whichever the running
# build used, so list all of them: iOS, Android, Web.
#
# Leave empty to switch Google sign-in off — the endpoint then returns 503 and
# says so, rather than failing as though the token were bad.
#
# These are public identifiers, not secrets. They ship inside the app.
GOOGLE_CLIENT_IDS=
