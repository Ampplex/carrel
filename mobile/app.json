{
  "expo": {
    "name": "Carrel",
    "slug": "Carrel",
    "version": "1.0.0",
    "scheme": [
      "carrel",
      "com.ampplex.carrel"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Carrel uses the camera so you can photograph a whiteboard, a slide or a page and ask about it later.",
        "NSPhotoLibraryUsageDescription": "Carrel reads photos you choose so it can remember them and answer questions about them later.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.906486716708-1a416qkttft2c72n1abgarr3pic1h02c"
            ]
          }
        ]
      },
      "bundleIdentifier": "com.ampplex.carrel"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.ampplex.carrel"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Carrel reads photos you choose so it can remember them and answer questions about them later.",
          "cameraPermission": "Carrel uses the camera so you can photograph a whiteboard, a slide or a page and ask about it later."
        }
      ],
      "expo-web-browser"
    ]
  }
}
